#include <behaviors.dtsi>#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE    0
#define NAVNNUM 1
#define SYM     2
#define XTRA    3
#define HW      4

#define BACK LG(LBKT)
#define FWD LG(RBKT)

&mt {
  quick-tap-ms = <100>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <170>;
};

&sk {
    release-after-ms = <300>;
    quick-release;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAVNNUM SYM>;
            then-layer = <XTRA>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            label = "BASE";
            bindings = <
                            &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y       &kp U           &kp I       &kp O       &kp P
                            &mt LSHFT A     &mt LCTRL S     &mt LALT D      &mt LGUI F      &kp G           &kp H       &mt RGUI J      &mt RALT K  &mt RCTRL L &mt RSHFT SEMI
                &kp LSHFT   &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N       &kp M           &kp COMMA   &kp DOT     &kp SQT             &kp RSHFT
                                                            &mo HW          &mo NAVNNUM     &kp SPACE       &kp RET     &mo SYM         &none
            >;
        };

        nav_n_num_layer {
            label = "NAVNNUM";
            bindings = <
                            &kp KP_N1       &kp KP_N2       &kp KP_N3       &kp KP_N4       &kp KP_N5       &kp KP_N6   &kp KP_N7       &kp KP_N8   &kp KP_N9   &kp KP_N0
                            &sk LSHFT       &sk LCTRL       &sk LALT        &sk LGUI        &none           &kp LEFT    &kp DOWN        &kp UP      &kp RIGHT   &kp BSPC
                &trans      &kp ESC         &kp TAB         &kp BACK        &kp FWD         &kp LPAR        &none       &none           &none       &none       &kp DEL             &trans
                                                            &trans          &trans          &trans          &trans      &trans          &trans
            >;
        };

        sym_layer {
            bindings = <
                            &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &kp CARET   &kp AMPS        &kp ASTRK   &kp LPAR    &kp RPAR
                            &sk LSHFT       &sk LCTRL       &sk LALT        &sk LGUI        &none           &none       &kp MINUS       &kp EQUAL   &none       &kp GRAVE
                &trans      &none           &kp LBRC        &kp RBRC        &none           &none           &none       &kp BSLH        &kp LBKT    &kp RBKT    &kp FSLH            &trans
                                                            &trans          &trans          &trans          &trans      &trans          &trans
            >;
        };

        xtra_layer {
            label = "XTRA";
            bindings = <
                            &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6      &kp F7          &kp F8      &kp F9          &kp F10
                            &sk LSHFT       &sk LCTRL       &sk LALT        &sk LGUI        &kp HOME        &kp PG_UP   &sk RGUI        &sk RALT    &sk RCTRL       &sk RSHFT
                &trans      &kp C_BRI_DN    &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp END         &kp PG_DN   &kp C_VOL_DN    &kp C_MUTE  &kp C_VOL_UP    &kp C_BRI_DN    &trans
                                                            &trans          &trans          &trans          &trans      &trans          &trans
            >;
        };

        hw_layer {
            label = "HW";
            bindings = <
                            &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_SEL 5    &bt BT_CLR  &none           &none       &none           &none
                            &bootloader     &out OUT_TOG    &none           &none           &none           &none       &none           &none       &none           &none
                &trans      &sys_reset      &none           &none           &none           &none           &none       &none           &none       &none           &none           &trans
                                                            &trans          &trans          &trans          &trans      &trans          &trans
            >;
        };
    };
};
